# --- Hyperliquid L4 dataset (Albers et al., 2026 — https://zenodo.org/records/18184441) ---
# Too large for GitHub. Re-download and extract with data/download_data.sh.
data/order_statuses/
data/trades/
data/mapdir/
data/sample/order_statuses/
data/sample/trades/
data/sample/mapdir/users.csv
data/sample/mapdir/value_stats.csv
data/sample/**/*.gz
data/*.tar
data/*.tar.xz
data/*.log
data/__pycache__/
data/results/

cloud_results/

# --- `download` command's own data (BTC/ETH/SOL order-status archives,
# fetched on demand by src/inputs/download_cmd.rs) — separate from the
# top-level data/ tree above, entirely downloaded artifacts, nothing here
# is ever meant to be committed ---
src/data/
src/output/*.csv

# --- Rust build artifacts ---
target/
**/target/

# --- `simulate` command output (generated, can be large) ---
output/

# --- Full-month simulation output used by the thesis analysis
# (results/sol/{fba,cda}_timeseries.csv are 600MB+ each -- far over
# GitHub's 100MB hard limit). Regenerate via `simulate sol 1` (see
# src/docs/DEPLOY.md) or pull from the GCS output bucket; never meant
# to be committed. ---
results/

# --- analysis/ pipeline's own generated/derived output (regenerate via
# `python analysis/run_all.py`) ---
analysis/output/

# --- Python cache ---
__pycache__/
*.pyc

# --- Thesis exposé: kept locally, not published to the public repo ---
docs/expose.tex

# --- Downloaded copies of cited papers (open-access only), for local
# reading convenience; not redistributed via the public repo ---
bibliography_pdfs/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
