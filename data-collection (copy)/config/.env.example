# Sample environment variables for Polymarket CLOB and blockchain access
# Copy this file to `config/.env` and fill with your real credentials.
# Do not commit real secrets.

# API credentials
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Alternate API credential names supported by some scripts
api_key=
api_secret=
api_passphrase=

# Wallet / account
PRIVATE_KEY=
PK=
FUNDER=
DERIVED=
PROXY_ADDRESS=

# Chain / network config
USDC_CONTRACT_ADDRESS=0x2791bca1f2de4661ed88a30c99a7a9449aa84174
DATA_API_URL=https://data-api.polymarket.com/positions
CLOB_API_URL=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com
GAMMA_API_URL=https://gamma-api.polymarket.com
